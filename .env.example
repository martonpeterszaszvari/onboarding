# Copy to .env, then run: docker compose up --build -d
# Demo credentials only; use secure secrets for any nonlocal deployment.
POSTGRES_DB=onboarding
POSTGRES_USER=onboarding
POSTGRES_PASSWORD=onboarding
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173

# mock works without a Hunter.io account.
HUNTER_MODE=mock
HUNTER_API_KEY=
HUNTER_FAST_TIMEOUT_MS=2000
PENDING_DELAY_SECONDS=4
RETRY_BASE_SECONDS=2
WORKER_CONCURRENCY=3

# For real Hunter, use HUNTER_MODE=real and PENDING_DELAY_SECONDS=60
